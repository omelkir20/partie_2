nodes = [
  { name: "lab1", ip: "192.168.56.11", web: 18081, jenkins: 18082, portainer: 19443 },
  { name: "lab2", ip: "192.168.56.12", web: 18091, jenkins: 18092, portainer: 19444 }
]
Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-24.04"

  nodes.each_with_index do |n, i|
    config.vm.define n[:name] do |node|
      node.vm.hostname = n[:name]
      node.vm.network "private_network", ip: n[:ip]
      node.vm.network "forwarded_port", guest: 80,   host: n[:web],       host_ip: "0.0.0.0"
      node.vm.network "forwarded_port", guest: 8080, host: n[:jenkins],   host_ip: "0.0.0.0"
      node.vm.network "forwarded_port", guest: 9443, host: n[:portainer], host_ip: "0.0.0.0"

      node.vm.provider "virtualbox" do |vb|
        vb.name   = n[:name]
        vb.memory = 2048
        vb.cpus   = 2
      end

      # Ansible une seule fois, quand les 2 VM sont prêtes
      if i == nodes.size - 1
        node.vm.provision "ansible" do |a|
          a.playbook = "playbook.yml"
          a.limit = "all"
        end
      end
    end
  end
end
